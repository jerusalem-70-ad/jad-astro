---
import NavLink from "@/components/nav-link.astro";
import { Icon } from "astro-icon/components";
interface Props {
	title: string;
	url?: string | null;
	icon?: string;
	image?: any;
}

const { title, url, icon,  } = Astro.props;
---

<article>
	<div >
		<NavLink href={url} class="no-underline">
			<div class="flex h-16 overflow-hidden rounded-md shadow-md text-center bg-brand-800/90 text-brand-50/80 p-2 transition-all duration-300 hover:bg-brand-900/95 justify-items-start gap-1"
				>
				<Icon class="w-1/4 self-center inline-flex " aria-hidden="true" name={icon} />
				<h2 class="w-3/4 self-center text-sm font-semibold">
					<span class="no-underline">{title}</span>
				</h2>
					
			</div>
		</NavLink>
	</div>
</article>
