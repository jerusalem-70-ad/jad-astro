---
interface Keyword {
  jad_id: string;
  name: string;
  passages?: unknown[];
  description?: string;
}

interface Props {
  keywords: Keyword[];
}

const { keywords } = Astro.props;

// Prepare chart data
const sortedKeywords = keywords
  .map((keyword) => ({
    jad_id: keyword.jad_id,
    name: keyword.name,
    passageCount: keyword.passages?.length ?? 0,
    description: keyword.description ?? "",
  }))
  .sort((a, b) => b.passageCount - a.passageCount);

const chartData = {
  categories: sortedKeywords.map((k) => k.name),
  values: sortedKeywords.map((k) => k.passageCount),
  descriptions: sortedKeywords.map((k) => k.description),
  ids: sortedKeywords.map((k) => k.jad_id),
};
---

<div
  id="keywords-chart"
  data-chart={JSON.stringify(chartData)}
  style="width: 100%; height: 1400px;"
></div>

<script>
  import * as echarts from "echarts";
  import { withBasePath } from "@/lib/withBasePath";

  let chart: echarts.ECharts | null = null;

  function initChart() {
    const chartElement = document.getElementById("keywords-chart");

    if (!chartElement) return;

    // Read chart data from the HTML element
    const chartData = JSON.parse(chartElement.dataset.chart ?? "{}");

    // Dispose of an existing instance, if necessary
    const existingChart = echarts.getInstanceByDom(chartElement);
    existingChart?.dispose();

    chart = echarts.init(chartElement);

    chart.setOption({
      tooltip: {
        trigger: "axis",
        axisPointer: {
          type: "shadow",
        },
        formatter: (params: any) => {
          const dataIndex = params[0].dataIndex;
          const description = chartData.descriptions[dataIndex];

          return `
            <strong>${params[0].name}</strong><br/>
            Passages: ${params[0].value}<br/>
            ${
              description
                ? `<em>${description.substring(0, 150)}${description.length > 150 ? "..." : ""}</em>`
                : ""
            }
            <br/><small style="color: #666;">Click to view details</small>
          `;
        },
      },

      grid: {
        left: "10%",
        right: "4%",
        top: "4%",
        bottom: "3%",
        containLabel: true,
      },

      xAxis: {
        type: "value",
        name: "Number of Passages",
        nameLocation: "middle",
        nameGap: 30,
      },

      yAxis: {
        type: "category",
        data: chartData.categories,
        axisLabel: {
          fontSize: 12,
          interval: 0,
          width: 250,
          overflow: "truncate",
        },
        inverse: true,
      },

      series: [
        {
          name: "Passages",
          type: "bar",
          data: chartData.values.map((value: number) => ({
            value,
            itemStyle: {
              color: new echarts.graphic.LinearGradient(0, 0, 1, 0, [
                { offset: 0, color: "#a92d03" },
                { offset: 0.7, color: "#6f2009" },
                { offset: 1, color: "#581908" },
              ]),
            },
          })),
          emphasis: {
            itemStyle: {
              color: new echarts.graphic.LinearGradient(0, 0, 1, 0, [
                { offset: 0, color: "#e6d5c3" },
                { offset: 0.5, color: "#e5894a" },
                { offset: 1, color: "#a92d03" },
              ]),
            },
          },
          cursor: "pointer",
        },
      ],

      toolbox: {
        show: true,
        orient: "vertical",
        right: 30,
        top: 20,
        itemSize: 20,
        itemGap: 20,
        feature: {
          saveAsImage: {
            show: true,
            title: "Download as PNG",
            type: "png",
            pixelRatio: 2,
            backgroundColor: "#fff",
          },
        },
      },
    });

    // Handle bar clicks
    chart.on("click", (params) => {
      if (params.componentType === "series") {
        const keywordId = chartData.ids[params.dataIndex];

        const detailUrl = withBasePath(`/data/keywords/${keywordId}`);

        window.location.href = detailUrl;
      }
    });

    // Handle hover cursor
    chart.on("mouseover", (params) => {
      if (params.componentType === "series") {
        chartElement.style.cursor = "pointer";
      }
    });

    chart.on("mouseout", () => {
      chartElement.style.cursor = "default";
    });

    window.addEventListener("resize", resizeChart);
  }

  function resizeChart() {
    chart?.resize();
  }

  function cleanupChart() {
    window.removeEventListener("resize", resizeChart);
    chart?.dispose();
    chart = null;
  }

  document.addEventListener("astro:page-load", initChart);
  document.addEventListener("astro:before-swap", cleanupChart);
</script>