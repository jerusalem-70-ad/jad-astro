---
import PageLayout from "@/layouts/page-layout.astro";
import ToolsCard from "@/components/ui/ToolCard.astro";
---

<PageLayout title="Tools">
	<div class="mx-auto w-full max-w-(--breakpoint-lg) p-2 md:px-10 md:py-16">
		<div>
			<div class="p-4 md:p-8 border-neutral-300 rounded-md bg-white shadow-lg">
				<h1 class="text-2xl md:text-4xl font-semibold text-brand-900 pb-4">
					Analysis, search and visualisation tools
				</h1>
				<p>
					A range of tools for exploring, analysing, and visualising the data.
				</p>
			</div>
			<div class="grid gap-5 py-5">

                <ToolsCard
                    titleCard="Visualisation Dashboard"
                    href="/tools/dashboard"
                    icon="layout-dashboard"
                    what="Explore the corpus through interactive timelines, graphs, heatmaps, and distribution charts all connected to one filter panel."
                    why="Reveal patterns, trends, and relationships that may be difficult to identify in tabular data."
                    how="Apply filters from the side panel and explore the interactive visualisations. 
                    Hover and click for details or download the visualisation."
                    questions="How do passages relate to one another over time? Which themes, references, or genres dominate the corpus? How do keywords change across centuries?"
                />
                 <ToolsCard
                    titleCard="Biblical References Explorer"
                    href="/tools/biblical-refs"
                    icon="chart-scatter"
                    what="An interactive scatter plot showing which passages cite a chosen chapter of the Bible."
                    why="See at a glance which verses were cited most, in which centuries, and in which kinds of texts. Patterns that are hard to spot in a list, such as a verse that becomes popular in a particular period or genre, become visible."
                    how="Select a biblical book, then a chapter."
                    questions="Which verses of a chapter attract the most citations? Do certain genres cite a book more than others? How does the use of a passage change over the centuries?"
                />
               <ToolsCard
                    titleCard="Biblical Commentaries Explorer"
                    href="/tools/biblical-commentaries"
                    icon="table"
                    what="A table showing which commentaries discuss which chapters of a given Bible book."
                    why="Seeing all passages side by side reveals which chapters attracted the most attention, and which were largely ignored."
                    how="Choose a Bible book from the menu. Each row is a commentary, each column a chapter, and each X links to the passage."
                    questions="Which commentaries engage with Isaiah 60? Which chapters of Luke were commented on most? Which commentaries cover a book only partially?"
                    />
                <ToolsCard
                    titleCard="Text Comparison"
                    href="/tools/text-comparisons"
                    icon="git-compare-arrows"
                    what="Compare related passages side by side."
                    why="Examine textual reuse, adaptation, and transmission within the corpus."
                    how="Search for a passage and display its source or derivative texts as recorded in the database. Additional passages can be added for comparison."
                    questions="How was a narrative adapted by later authors? Which passages share the same source?"
                />
                <ToolsCard
                    titleCard="Similarity Graph"
                    href="/tools/ai-graph"
                    icon="bot"
                    what="Explore AI-assisted similarity relationships between passages."
                    why="Identify passages that may be textually or thematically related beyond manually established connections."
                    how="Search for a passage identifier and inspect the pre-calculated similarity network."
                    questions="Which passages are most similar to a given text? Are there previously unnoticed relationships?"
                />
				<ToolsCard
                    titleCard="Advanced Search"
                    href="/search"
                    icon="search"
                    what="Search and explore all project data through a unified interface."
                    why="Quickly narrow large result sets using filters works, authors, manuscripts, keywords, and other metadata."
                    how="Enter text to search and/or refine the results using the available filters. Results update instantly as filters are applied."
                    questions="Which passages mention a particular theme? In which period is a particular keyword most frequent?"
                />
                <ToolsCard
                    titleCard="Linguistic Search"
                    href="/linguistic-search"
                    icon="text-search"
                    datareload = {true}
                    what="The linguistic search allows you to search for complex linguistic patterns in the texts using Simple, Phrase, Lemma, and Corpus Query Language (CQL) search modes."
                    why="Find linguistic patterns that cannot be discovered through metadata filters alone. Detect textual relations and transmissions."
                    how="Search by word forms, lemmas, wildcards, or word distance to detect relationships accross passages. Refine the results using metadata filters."
                    questions="How is a particular concept expressed across different texts? Which passages contain similar phrases?"
                />
			</div>
		</div>
	</div>
</PageLayout>
