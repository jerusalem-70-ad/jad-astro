---
import PageLayout from "@/layouts/page-layout.astro";
import Article from "@/components/article.astro";
import works from "@/content/data/works.json";
import NavLink from "@/components/nav-link.astro";
import { Icon } from "astro-icon/components";
import type { WorkFull } from "@/types";

import TabulatorTable from "@/components/tabulator-table.svelte";
import { workTableConfig } from "@/lib/tabulator/tabulator-table-configs.js";

export async function getStaticPaths() {
    const paths = Object.values(works).map((work) => ({
        params: { id: work.jad_id },
        props: { data: work as WorkFull },
    }));
    return paths;
}
const { data: work } = Astro.props;

const edition = work.edition ?? "";
const edition_html = edition.replace(/\*(.*?)\*/g, "<em>$1</em>")

// Transform data and prepare columns for Tabulator Table
const tableData = workTableConfig.transformData(work.related__passages ?? []);
const columns = workTableConfig.getColumns();
const rowClickConfig = workTableConfig.getRowClickConfig;

---

<PageLayout title={work.title}>
    <Article
        prevLink={`/data/works/${work.prev.id}`}
        nextLink={`/data/works/${work.next.id}`}
        mainTitle={work.author.length > 0
            ? work.author.map((item) => item.name).join(", ") +
              ": " +
              work.title
            : work?.title}
    >
    <div class="flex justify-end m-2">               
                <NavLink href=`/download/tei/works/${work.jad_id}.xml` 
                class="border border-brand-800 rounded-md py-2 px-4 bg-brand-600 text-brand-100 hover:bg-brand-100 hover:text-brand-800 transition"
                id="download-tei">TEI</NavLink>             
                
     </div>
        <dl class="grid grid-cols-[1fr_5fr] text-sm md:leading-7 md:text-base">
            <dt class="font-semibold text-brand-900 border-r border-neutral-300 pr-5">Author:</dt>
            <dd class="pl-5">
                {
                    work.author && work.author.length > 0 ? (
                        <NavLink href={`/data/authors/${work.author[0].jad_id}`}>
                            {work.author[0]?.name}
                            {work.author_certainty === false && " (?)"}
                        </NavLink>
                    ) : (
                        "N/A"
                    )
                }
            </dd>
          

            <dt class="font-semibold text-brand-900 border-r border-neutral-300 pr-5">
                Manuscripts:
            </dt>
            <dd class="pl-5">
                {
                    work.manuscripts.length > 0
                        ? work.manuscripts.map((ms,index,) => (
                                  <>
                                      <NavLink
                                          href={`/data/manuscripts/jad_manuscript__${ms.id}`}
                                      >
                                          {ms.name}
                                      </NavLink>
                                      {index < work.manuscripts.length - 1 &&
                                          "| "}
                                  </>
                              ),
                          )
                        : "N/A"
                }
            </dd>

            <dt class="font-semibold text-brand-900 border-r border-neutral-300 pr-5">Genre:</dt>
            <dd class="pl-5">
                {work.genre ? work.genre : "N/A"}
            </dd>

            <dt class="font-semibold text-brand-900 border-r border-neutral-300 pr-5">
                Edition:
            </dt>
            <dd class="pl-5"> 
               
                {
                edition && (
                    <span set:html={edition_html}></span>
                )
                }
                {work.link_digital_editions &&
                <span>  (<NavLink href={work?.link_digital_editions}>
                   Facsimile{" "}
                                  <Icon
                                    name="lucide:external-link"
                                    class="size-4 inline-flex"
                                  /></NavLink>)</span>}
            </dd>
            
           
            <dt class="font-semibold text-brand-900 border-r border-neutral-300 pr-5">Date:</dt>
            <dd class="pl-5">
                {
                    work.date.length > 0
                        ? work.date
                              .map((singleDate) => singleDate.value)
                              .join(", ")
                        : "N/A"
                }
                {
                    work.date.length > 0 &&
                        work.date_certainty === false &&
                        " (?)"
                }
            </dd>
      
        </dl>
        

         {tableData.length > 0 && (
            <TabulatorTable
            client:only="svelte"
            data={tableData}
            columns={columns}
            tableId="passages-table"
            options={{                
                paginationSize: 25,
                responsiveLayout: "collapse",
                 initialSort: [
                     { column: "key", dir: "asc" },            // sort by position in work key
                    { column: "liturgicalDate", dir: "asc" },
                ],
            }}
            downloadTitle="jad_related_passages"
            rowClickConfig={rowClickConfig}
            /> )}
    </Article>
</PageLayout>
