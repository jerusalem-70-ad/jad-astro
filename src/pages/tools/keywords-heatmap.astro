---
import KeywordsHeatmap from "@/components/visualisations/keywords-heatmap.svelte"
import KeywordsClusterHeatmap from "@/components/visualisations/keywords-cluster-heatmap.svelte"
import PageLayout from "@/layouts/page-layout.astro";
import CheckItem from "@/components/ui/check-list-item.astro"
import About from "@/components/ui/chart-about.astro"
import ToggleAside from '@/components/toggle-aside.astro';
import Article from '@/components/article.astro';
import SearchPanel from "@/components/search/search-panel.svelte"


---
 <PageLayout title="Keywords Heatmap">
   <ToggleAside>
        <SearchPanel slot="aside" client:only="svelte" />
    <Article wide={true} slot="main" mainTitle="Keywords Heatmap">
     <div class="grid gap-2">
         
         <About>
            <ul slot="about" class="px-5 py-2 list-inside list-disc space-y-1">
                <li>
                    These heat maps shows how <span class="font-semibold">keywords are distributed 
                        across centuries</span> and <span class="font-semibold">across clusters</span> respectively.
                    Only keywords with at least 10 occurrences in total are included.
                </li>
                <li>
                    <span class="underline underline-offset-2">How the data is counted:</span> each passage can
                    have several keywords, so one passage appears in several columns of the map. <br/>
                    NB! Works are dated to a range, not to a single year, so
                    a passage is often counted in two neighbouring centuries. For both reasons, the numbers in
                    the map do not add up to the total number of passages.
                </li>
                <li>
                    <span class="underline underline-offset-2">How to read the axes:</span> the x-axis lists the
                    keywords found in the selected passages. In the first heat map the y-axis is the time axis, with one row per
                    century, in the second - the clusters. Each cell shows how often a keyword occurs in passages from that century
                    or in relation to a cluser.
                </li>
                <li>
                    <span class="underline underline-offset-2">Color intensity:</span> the darker the cell, the
                    higher the value. Empty (light) cells mean that the keyword does not occur in that century / cluster.
                </li>
                <li>
                    <span class="underline underline-offset-2">Two counting modes</span>:{" "}
                    <span class="font-semibold">Absolute</span> shows the number of passages in which the keyword
                    appears. <span class="font-semibold">Percentage</span> shows how much that is in respect to 
                    all other passages in this centuries / in this cluster. Example: in the 3rd century there are a total of 7
                    passages; there is 1 passage related to 'Antichrist' (absolute value), which makes 14 % of all
                    passages in the century (relative value). 
                </li>
            </ul>
            <ul slot="howTo" class="px-5 py-2 list-inside space-y-1">
                <CheckItem>Look at the heat maps as a whole to spot patterns, for example keywords that peak in one century.</CheckItem>
                <CheckItem>Use the side search panel to narrow the selection, e.g. to a particular place or to the works of one author.</CheckItem>
                <CheckItem>Switch the mode between 'absolute' and 'percentage' to compare raw numbers with relative frequency.</CheckItem>
                <CheckItem>Hover over a cell for details, and click it to open the passages.</CheckItem>
                <CheckItem>Use the range selection to show only keywords within a custom frequency range, e.g. keywords with at least 40 passages in at least one century.</CheckItem>
            </ul>
         </About>
         
          <KeywordsHeatmap client:load />
          <KeywordsClusterHeatmap client:load />
     </div>
    </Article>
  </ToggleAside>
</PageLayout>
