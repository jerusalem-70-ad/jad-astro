---
import BibleCommentaries from "@/components/visualisations/bible-commentaries.svelte";
import passagesForBibleComm from "@/content/data/passagesForBiblComm.json"
import PageLayout from "@/layouts/page-layout.astro";
import CheckItem from "@/components/ui/check-list-item.astro"
import About from "@/components/ui/chart-about.astro"
import Article from '@/components/article.astro';

---
 <PageLayout title="Biblical Refs Scatter Chart">
      <Article wide={true} mainTitle="Biblical Commentaries Table">

        <div class="grid gap-2">
         <About>
                <ul slot="about" class="px-5 py-2 list-inside list-disc space-y-1">
                    <li>
                        There are {passagesForBibleComm.length} passages in the database that
                        comment on a book of the Bible. This interactive table shows { }
                        <span class="font-semibold">which passages comment upon a chosen Bible book</span>.
                    </li>
                    <li>
                        <span class="font-semibold">Each row is a commentary</span>, and the passages
                        taken from it are plotted inside the row.
                        </li>
                    <li><span class="font-semibold">Each
                        column is a chapter</span> of the selected Bible book. Only chapters with at
                        least one passage commenting on them are shown.
                    </li>
                    <li>
                        <span class="font-semibold">Please note:</span> the table is not exhaustive.
                        There might be further commentaries not recorded here or a commentary may discuss
                        a Bible book more extensively than shown here. The database only records passages
                        relevant to this project.
                    </li>
                </ul>
                 <ul slot="howTo" class="px-5 py-2 list-inside space-y-1">
                <CheckItem>Select a biblical book from the menu.</CheckItem>
                <CheckItem>Hover over an X to show the passage number.</CheckItem>
                <CheckItem>Click on the X to see the detail view page.</CheckItem>
            </ul>
         </About>
          
             <BibleCommentaries client:load {passagesForBibleComm}/>
     </div>
    </Article>
</PageLayout>
