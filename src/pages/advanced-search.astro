---
import Layout from "@/layouts/page-layout.astro";
import "instantsearch.css/themes/satellite.css";
import { Icon } from "astro-icon/components";
import NavLink from "@/components/nav-link.astro";
import SearchPanel from "@/components/search/filter-panel.astro";
---

<Layout title="Search">
  <div class="md:w-5/6 mx-auto md:p-6 p-2">
    <div class="grid grid-cols-[500px_1fr] py-3">
      <div class="inline-flex items-stretch justify-stretch border border-gray-200 rounded-2xl shadow bg-brand-500/60 p-1">
          <h2 class="bg-brand-50 text-xl p-3 md:text-3xl font-semibold text-brand-600 rounded-2xl">
            Advanced Search
          </h2>
      
            <NavLink reload
                href="/noske-search"
                class="group relative p-3 text:lg md:text-2xl font-semibold text-brand-200 hover:text-brand-50"
              >
                Linguistic Search
                <span
                  class="absolute left-full top-1/2 z-50 hidden -translate-y-1/2  ml-2 whitespace-nowrap rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-normal text-gray-800 shadow-md group-hover:block"
                >
                  Switch to linguistic search to apply more advanced linguistic queries like searching with wild cards, word distance, or lemmata.
                </span>
              </NavLink>
        </div>
        <p class="hidden 2xl:block px-3 text-brand-800 font-normal 2xl:text-base text-sm">The advanced <strong>faceted search</strong> allows you to search in the text and to explore the corpus using predefined metadata categories. Use the filters in the 
          panel below to narrow down the passages by specific characteristics and combinations of metadata. </p>
    </div>

    <div class="md:space-y-6">
      <!-- Search Input and Stats -->
      <div class="flex items-center gap-2">
        <button
          id="filter-button"
          aria-label="filter"
          class="md:hidden flex items-center justify-center rounded-lg border border-neutral-300 w-12 h-12"
        >
          <Icon aria-hidden="true" name="lucide:sliders-horizontal" />
        </button>

        <div id="searchbox" class="flex-1 p-1 rounded-md md:bg-brand-400"></div>
      </div>
      <!-- Refinements and Results -->
      <div class="grid md:grid-cols-[1fr_3fr] gap-6">
        <!-- Refinements Section -->
         <SearchPanel/>      

       <section class="space-y-3">

  <!-- stats and sort Section -->
  <div class="md:flex items-center space-y-2 md:space-y-0">

    <div
      id="stats-container"
      class="flex items-center gap-2 text-sm font-medium text-neutral-700"
    ></div>

    <div class="flex items-center gap-3 border-l pl-3 min-w-0 text-sm ms-auto">
      <h3 class="text-center font-semibold uppercase text-neutral-700">
        Sort by:
      </h3>
      <div id="sort"></div>
    </div>

  </div>
<!-- current refinements nd clear -->
 <div class="grid min-w-0 grid-cols-[minmax(0,1fr)_auto] items-start gap-2">
  <div id="current-refinements" class="min-w-0 text-sm text-gray-600"></div>
  <div id="clear-refinements" class="flex items-center"></div>
</div>
<!-- Hits -->
  <div id="hits" class="bg-white p-2 md:p-4 rounded-lg shadow-xs"></div>
<!-- Paginiation -->
  <div id="ts-pagination" class="flex md:justify-center"></div>

</section>
      </div>
    </div>
  </div>
</Layout>

<script src="@/lib/advanced-search.js"></script>

<script>
  const infoButton = document.getElementById('filter-info');
  const dialog = document.getElementById('filter-info-dialog');
  const closeButton = document.getElementById('filter-info-close');

  if (
    infoButton instanceof HTMLButtonElement &&
    dialog instanceof HTMLDialogElement &&
    closeButton instanceof HTMLButtonElement
  ) {
    infoButton.addEventListener('click', () => {
      dialog.showModal();
    });

    closeButton.addEventListener('click', () => {
      dialog.close();
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });
  }
</script>